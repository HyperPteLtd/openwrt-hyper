# A confirmed takeover may retain this separate firewall guard while the core
# is unavailable. It neither accepts packets through zone policy nor touches WAN.
hold_note=hyper-fault-v1
hold_dir=$state/hold
guard_plan=$state/guard-plan

# Write both backends from the same ordered device policy. The input is a root
# handoff produced from the configuration that is about to become active.
guard_rules() {
 awk -v engine="$1" -v family="$2" -v devices="$interfaces" -v v6="$v6" -v dns="$dns" -v intercept="$dns_intercept" -v tag="$hold_note" -v priv4="$bypass4" -v priv6="$bypass6" -v local4="$(local_prefixes 4)" -v local6="$(local_prefixes 6)" '
 function xt(chain, spec, action) { print "-A " chain " " spec " -m comment --comment " tag " " action }
 function prefix_ok(f,s) { return (f=="4" ? s ~ /^[0-9.]+\/[0-9]+$/ : s ~ /^[a-fA-F0-9:.]+\/[0-9]+$/) }
 BEGIN {
  n=split(devices,dev," ")
  if (engine=="nft") {
   print "table inet hyper_hold {\n comment \"" tag "\""
   print "chain blocked {"
   # Replies to connections opened from outside (port forwards, inbound services) are never held.
   print "ct direction reply return"
   if (dns) print "th dport 53 fib daddr type " (intercept ? "{ local, unicast }" : "local") " drop"
   print "fib daddr type { local, multicast, broadcast } return"
   gsub(/ /,", ",priv4); gsub(/ /,", ",priv6)
   print "ip daddr { " priv4 " } return\nip6 daddr { " priv6 " } return"
   # Attached networks may overlap, which an anonymous set rejects, so each gets its own rule.
   cnt=split(local4,p,"\n"); for (i=1;i<=cnt;i++) if (p[i]!="") print "ip daddr " p[i] " return"
   cnt=split(local6,p,"\n"); for (i=1;i<=cnt;i++) if (p[i]!="") print "ip6 daddr " p[i] " return"
   print "drop\n}"
   print "chain device_routes {"
  } else {
   print "*mangle\n-N OW_HOLD\n-N OW_HOLD_DEV\n-N OW_HOLD_BLOCK"
   if (dns) {
    types=(intercept ? "LOCAL,UNICAST" : "LOCAL")
    xt("OW_HOLD_BLOCK","-p tcp --dport 53 -m addrtype --dst-type " types,"-j DROP")
    xt("OW_HOLD_BLOCK","-p udp --dport 53 -m addrtype --dst-type " types,"-j DROP")
   }
   xt("OW_HOLD_BLOCK","-m conntrack --ctdir REPLY","-j RETURN")
   xt("OW_HOLD_BLOCK","-m addrtype --dst-type " (family==4 ? "LOCAL,BROADCAST,MULTICAST" : "LOCAL,MULTICAST"),"-j RETURN")
   cnt=split((family==4 ? priv4 : priv6),p," ")
   for (i=1;i<=cnt;i++) xt("OW_HOLD_BLOCK","-d " p[i],"-j RETURN")
   cnt=split((family==4 ? local4 : local6),p,"\n")
   for (i=1;i<=cnt;i++) if (p[i]!="") xt("OW_HOLD_BLOCK","-d " p[i],"-j RETURN")
   xt("OW_HOLD_BLOCK","","-j DROP")
  }
 }
 # Even a truncated policy must not accidentally allow the rest of the LAN.
 $1=="default" && NF==2 && ($2=="block" || $2=="direct") && !def { def=$2; next }
 {
  if (def || NF!=3 || ($3!="direct" && $3!="block") ||
      (($1=="4" || $1=="6") ? !prefix_ok($1,$2) : ($1!="mac" || $2!~/^[a-fA-F0-9:]+$/ || length($2)!=17))) {bad=1; exit 1}
  if (engine=="nft") print ($1=="mac" ? "ether" : ($1=="4" ? "ip" : "ip6")) " saddr " $2 " " ($3=="direct" ? "return" : "goto blocked")
  else if ($1=="mac" || $1==family) xt("OW_HOLD_DEV",($1=="mac" ? "-m mac --mac-source " : "-s ") $2,($3=="direct" ? "-j RETURN" : "-g OW_HOLD_BLOCK"))
 }
 END {
  if (bad || !def) exit 1
  if (engine=="nft") {
   if (def=="block") print "goto blocked"
   print "}\nchain hold_lan { type filter hook prerouting priority mangle - 2; policy accept;"
   for (i=1;i<=n;i++) print "iifname \"" dev[i] "\" meta nfproto " (v6?"{ ipv4, ipv6 }":"ipv4") " meta l4proto { tcp, udp } goto device_routes"
   print "}\n}"
  } else {
   if (def=="block") xt("OW_HOLD_DEV","","-g OW_HOLD_BLOCK")
   for (i=1;i<=n;i++) {
    xt("OW_HOLD","-i " dev[i] " -p tcp","-g OW_HOLD_DEV")
    xt("OW_HOLD","-i " dev[i] " -p udp","-g OW_HOLD_DEV")
   }
   print "-I PREROUTING 1 -m comment --comment " tag " -j OW_HOLD\nCOMMIT"
  }
 }' "$3"
}
# Flowtable lookups happen at ingress, before our prerouting hook. A VLAN
# may be accelerated through its underlying bridge or a bridge port.
guard_offload_interfaces() (
 dev=$1; depth=$2
 echo "$dev"
 [ "$depth" -lt 8 ] || return 0
 for lower in /sys/class/net/"$dev"/lower_*; do
  [ -L "$lower" ] || continue
  guard_offload_interfaces "${lower##*/lower_}" "$((depth+1))"
 done
)
guard_no_offload() {
 guard_backend=$1; guard_ingress=$2
 if command -v nft >/dev/null; then
  ft=$(nft -j list flowtables 2>/dev/null) || { [ "$guard_backend" != fw4 ] || return 1; ft=; }
  attached=$(printf '%s\n' "$ft" | jsonfilter -e '@.nftables[*].flowtable.dev' -e '@.nftables[*].flowtable.dev[*]' 2>/dev/null || :)
  if [ -n "$attached" ]; then
   for ifname in $guard_ingress; do
    links=$(guard_offload_interfaces "$ifname" 0)
    for link in $links; do
     if printf '%s\n' "$attached" | grep -Fqx "$link"; then return 1; fi
    done
   done
  fi
 fi
 if [ "$guard_backend" = fw3 ]; then
  for family in 4 6; do
   [ "$family" = 4 ] || [ "$3" = 1 ] || continue
   xt=$(legacy_tool "$family") || return 1
   rules=$("$xt" -w 2 -t filter -S) || return 1
   # Only reachable forwarding rules can send a connection to the legacy
   # fast path. An unreferenced chain from a stopped firewall is harmless.
   if printf '%s\n' "$rules" | awk '
    $1=="-A" {for(i=3;i<NF;i++) if($i=="-j" || $i=="-g") {src[++n]=$2; dst[n]=$(i+1)}}
    END {known["FORWARD"]=1; do {changed=0; for(i=1;i<=n;i++) if(known[src[i]] && !known[dst[i]]) {known[dst[i]]=1; changed=1}} while(changed); exit !known["FLOWOFFLOAD"]}'; then return 1; fi
  done
 fi
 return 0
}
guard_prepare() {
 mkdir -p "$guard_plan"
 policy=/var/run/hyper/device-guard.policy
 if [ ! -e "$policy" ]; then policy="$guard_plan/default"; echo 'default block' >"$policy"; fi
 if [ "$backend" = fw4 ]; then
  # A previous confirmed guard may remain live during retry. Validate the new
  # transaction under a temporary table name before exposing a new takeover.
  if nft list table inet hyper_hold >/dev/null 2>&1; then
   [ -f "$hold_dir/fw4" ] && guard_nft_owned || return 1
  fi
  guard_rules nft both "$policy" >"$guard_plan/fw4" || return 1
  sed "s/table inet hyper_hold/table inet ow_test_$$/" "$guard_plan/fw4" | nft -c -f - || return 1
 else
  for f in $legacy_families; do
   [ "$f" = 4 ] || [ "$v6" = 1 ] || continue
   xt=$(legacy_tool "$f") || return 1
   if [ ! -f "$hold_dir/fw3.$f" ]; then
    for chain in OW_HOLD OW_HOLD_DEV OW_HOLD_BLOCK; do
     if "$xt" -w 2 -t mangle -S "$chain" >/dev/null 2>&1; then return 1; fi
    done
   fi
   guard_rules xt "$f" "$policy" >"$guard_plan/fw3.$f" || return 1
   sed "s/OW_HOLD/OWT_$$/g" "$guard_plan/fw3.$f" | "$xt-restore" --test --noflush || return 1
  done
 fi
}
guard_nft_owned() {
 [ "$(nft -j list table inet hyper_hold | jsonfilter -e '@.nftables[*].table.comment')" = "$hold_note" ]
}
guard_check_xt() {
 listing=$("$1" -w 2 -t mangle -S) || return 1
 printf '%s\n' "$listing" | awk '$2=="OW_HOLD" || $2=="OW_HOLD_DEV" || $2=="OW_HOLD_BLOCK" || ($2=="PREROUTING" && $NF=="OW_HOLD")'
}
guard_install() {
 [ -f "$hold_dir/backend" ] || {
  backend=$(cat "$state/backend") || return 1
  mkdir -p "$hold_dir" || return 1
  cp "$state/interfaces" "$hold_dir/interfaces" || return 1
  if [ -f "$state/ipv6" ]; then touch "$hold_dir/ipv6" || return 1; fi
  if [ "$backend" = fw4 ]; then cp "$guard_plan/fw4" "$hold_dir/rules.nft" || return 1
  else
   cp "$guard_plan/fw3.4" "$hold_dir/rules.4" || return 1
   if [ -f "$state/ipv6" ]; then cp "$guard_plan/fw3.6" "$hold_dir/rules.6" || return 1; fi
  fi
  echo "$backend" >"$hold_dir/backend.new" && mv "$hold_dir/backend.new" "$hold_dir/backend" || return 1
 }
 backend=$(cat "$hold_dir/backend") || return 1
 lock_firewall "$backend" || return 1
 if [ "$backend" = fw4 ]; then
  if nft list table inet hyper_hold >/dev/null 2>&1; then
   [ -f "$hold_dir/fw4" ] && guard_nft_owned || return 1
  else
   touch "$hold_dir/fw4" && nft -f "$hold_dir/rules.nft" || return 1
   nft -s list table inet hyper_hold >"$hold_dir/fw4.active" || return 1
  fi
  live=$(nft -s list table inet hyper_hold) || return 1
  [ "$live" = "$(cat "$hold_dir/fw4.active")" ] || return 1
 else
  for f in 4 6; do
   [ -f "$hold_dir/rules.$f" ] || continue
   xt=$(legacy_tool "$f") || return 1
   if "$xt" -w 2 -t mangle -C PREROUTING -m comment --comment "$hold_note" -j OW_HOLD 2>/dev/null; then
    [ -f "$hold_dir/fw3.$f" ] || return 1
   else
    for chain in OW_HOLD OW_HOLD_DEV OW_HOLD_BLOCK; do
     if "$xt" -w 2 -t mangle -S "$chain" >/dev/null 2>&1; then return 1; fi
    done
    touch "$hold_dir/fw3.$f" && "$xt-restore" --noflush <"$hold_dir/rules.$f" || return 1
    guard_check_xt "$xt" >"$hold_dir/fw3.$f.active" || return 1
   fi
   live=$(guard_check_xt "$xt") || return 1
   [ "$live" = "$(cat "$hold_dir/fw3.$f.active")" ] || return 1
  done
 fi
 touch "$state/held" && unlock_firewall
}
guard_remove_xt() {
 f=$1
 xt=$(legacy_tool "$f") || return 1
 actual=$("$xt" -w 2 -t mangle -S) || return 1
 # Atomically delete our exact entries and only chains with no outside
 # contents or references. Interruption cannot strand an emptied owned chain.
 printf '%s\n' "$actual" | awk -v token="$hold_note" '
 function ours(c) {return c=="OW_HOLD" || c=="OW_HOLD_DEV" || c=="OW_HOLD_BLOCK"}
 BEGIN {print "*mangle"}
 $1=="-N" {exists[$2]=1}
 $1=="-A" {
  owner=0; target=""
  for (i=3; i<NF; i++) {
   if ($i=="--comment" && ($(i+1)==token || $(i+1)=="\""token"\"")) owner=1
   if ($i=="-g" || $i=="-j") target=$(i+1)
  }
  if (owner && (ours($2) || ($2=="PREROUTING" && target=="OW_HOLD"))) {
   seen[$2]=1; seen[target]=1; sub(/^-A /,"-D "); print
  } else {foreign[$2]=1; foreign[target]=1}
 }
 END {
  for (c in exists) if (ours(c) && seen[c] && !foreign[c]) print "-X " c
  print "COMMIT"
 }' >"$hold_dir/remove.$f" || return 1
 "$xt-restore" --noflush <"$hold_dir/remove.$f" || return 1
 rm -f "$hold_dir/fw3.$f" "$hold_dir/remove.$f"
}
guard_remove() {
 [ -d "$hold_dir" ] || return 0
 if [ -e "$hold_dir/fw4" ]; then
  lock_firewall fw4 || return 1
  tables=$(nft list tables) || return 1
  if printf '%s\n' "$tables" | grep -Fqx 'table inet hyper_hold'; then
   guard_nft_owned && nft delete table inet hyper_hold || return 1
  fi
  rm -f "$hold_dir/fw4"
  unlock_firewall
 fi
 for f in 4 6; do
  [ -f "$hold_dir/fw3.$f" ] || continue
  lock_firewall fw3 && guard_remove_xt "$f" || return 1
  unlock_firewall
 done
 rm -f "$hold_dir/interfaces" "$hold_dir/ipv6" "$hold_dir/backend" "$hold_dir/backend.new" "$hold_dir/rules.nft" "$hold_dir/rules.4" "$hold_dir/rules.6" "$hold_dir/fw4.active" "$hold_dir/fw3.4.active" "$hold_dir/fw3.6.active"
 rmdir "$hold_dir" && rm -f "$state/held"
}
fault() {
 if [ ! -e /var/run/hyper/stopping ] && [ "$(uci -q get hyper.main.fail_open || echo 1)" = 0 ]; then
  if [ -f "$state/armed" ] || [ -f "$state/held" ]; then
   guard_install || { fail_stage fault_protection; return 1; }
   guard_v6=0; [ ! -f "$hold_dir/ipv6" ] || guard_v6=1
   guard_no_offload "$(cat "$hold_dir/backend")" "$(cat "$hold_dir/interfaces")" "$guard_v6" || { fail_stage fault_flow_offload; return 1; }
   release_active >/dev/null && echo protected
   return
  fi
 fi
 release >/dev/null && echo direct
}
