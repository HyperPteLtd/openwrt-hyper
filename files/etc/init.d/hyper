#!/bin/sh /etc/rc.common
# rc.common consumes START, STOP and USE_PROCD after sourcing this service.
# shellcheck disable=SC2034
START=98
STOP=10
# rc.common's default stop discards the stop hook's status and always calls
# service delete. Use the same procd lock while handling presence and errors.
case "${action:-}" in
 stop|shutdown) . "$IPKG_INSTROOT/lib/functions/procd.sh" ;;
 *) USE_PROCD=1 ;;
esac

install_dir=/var/run/hyper
prepare_run_dir() {
 [ ! -L "$install_dir" ] && mkdir -p "$install_dir" && chmod 0711 "$install_dir"
}
start_service() {
 prepare_run_dir && rm -f "$install_dir/stopping" || return 1
 for role in guard serve; do
  procd_open_instance "$role"
  procd_set_param command /usr/sbin/hyperd "$role"
  procd_set_param respawn 3600 5 0
  procd_set_param term_timeout 20
  # The core inherits this from hyperd, as OpenClash's core has it.
  procd_set_param limits nofile="1000000 1000000"
  procd_set_param stderr 1
  procd_close_instance
 done
}

stop_hyper() {
 procd_lock
 prepare_run_dir || return 1
 marker=$(mktemp "$install_dir/.stopping.XXXXXX") && mv -f "$marker" "$install_dir/stopping" || return 1
 /usr/libexec/hyper/network release && /usr/libexec/hyper/procd-delete "${1:-}"
}

stop() { stop_hyper "$@"; }

restart() {
 trap '' TERM
 stop_hyper "$@" || return $?
 trap - TERM
 start "$@"
}

service_triggers() {
 procd_add_reload_trigger hyper
}
