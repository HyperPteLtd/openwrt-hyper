#!/bin/sh
case "$ACTION" in ifup|ifdown) ;;
 ifupdate) [ "${IFUPDATE_ADDRESSES:-}${IFUPDATE_ROUTES:-}${IFUPDATE_PREFIXES:-}${IFUPDATE_DATA:-}" != "" ] || exit 0 ;;
 *) exit 0 ;;
esac
[ -S /var/run/hyper/manager.sock ] || exit 0
# Every interface counts: uplinks go by many names (wwan, wan2, 4G modems, the dynamic wan_6 of
# PPPoE) and carry the IPv6 route, the resolver and attached networks; managed LANs come and go.
# The manager ignores events that change nothing it uses.
[ "$INTERFACE" != loopback ] || exit 0
# Keep the attached-network bypass sets current (new IPv6 prefix, PPPoE redial) before the manager
# reacts. Without a takeover there are none, so skip the helper's lock.
[ ! -e /var/run/hyper/network/owned ] || /usr/libexec/hyper/network refresh >/dev/null 2>&1 || :
/usr/sbin/hyperd notify-network
