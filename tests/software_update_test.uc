import { eq, done } from 'lib';
import { updateDue, runAutoUpdate } from 'software_update';

const off = { auto_check: false, auto_update: false };
const check = { auto_check: true, auto_update: false };
const install = { auto_check: false, auto_update: true };
eq('disabled skips even forced checks', updateDue(off, 0, 100000, true), false);
eq('first check runs', updateDue(check, null, 100000, false), true);
eq('recent check waits', updateDue(check, 99999, 100000, false), false);
eq('daily check becomes due', updateDue(check, 13600, 100000, false), true);
eq('automatic install checks independently', updateDue(install, 0, 100000, false), true);
eq('clock correction does not block updates', updateDue(check, 100001, 100000, false), true);
eq('preference change can request a check', updateDue(check, 99999, 100000, true), true);

let calls = 0, latest = install, args;
const apply = (req) => { calls++; args = req.args; return { result: true }; };
const ready = () => ({ result: true, update_available: true, installable: true });
runAutoUpdate(() => check, ready, apply);
eq('check only does not install', calls, 0);
runAutoUpdate(() => latest, () => ({ result: false }), apply);
runAutoUpdate(() => latest, () => ({ result: true, update_available: false, installable: true }), apply);
runAutoUpdate(() => latest, () => ({ result: true, update_available: true, installable: false }), apply);
eq('failed/current/unsupported releases do not install', calls, 0);
runAutoUpdate(() => latest, () => { latest = off; return ready(); }, apply);
eq('turning off while checking cancels install', calls, 0);
latest = install;
runAutoUpdate(() => latest, ready, apply);
eq('automatic update installs a new matching release', calls, 1);
eq('automatic update never forces a downgrade', args, { force: false, automatic: true });
done('software_update');
