# First boot: the core's group and this router's device identifier.

# The core runs as root in this group alone (as OpenClash's runs in nogroup); the firewall
# lets the group's sockets out uncaptured, so it is a group of its own, which nothing else uses.
. /lib/functions.sh
group_add_next hyper >/dev/null

# Sent to Hyper service as the device identifier; generated once and kept across
# upgrades (/etc/config/hyper is a conffile).
[ -n "$(uci -q get hyper.account.device_id)" ] || {
	uci -q set hyper.account.device_id="$(cat /proc/sys/kernel/random/uuid)"
	uci -q commit hyper
}

# /etc/config/hyper is kept across upgrades, so an older release's values are carried over
# here. The capture method is picked at each start (TProxy where the firewall has it): an
# old setting would be ignored, so it goes. smart and global are the routing modes; older
# names (bypass_mainland_china) mean smart, and the core would refuse to start with them.
[ -z "$(uci -q get hyper.config.proxy_mode)" ] || {
	uci -q delete hyper.config.proxy_mode
	uci -q commit hyper
}
case "$(uci -q get hyper.config.routing_mode)" in
	''|smart|global) ;;
	*) uci -q set hyper.config.routing_mode=smart; uci -q commit hyper ;;
esac

rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
exit 0
