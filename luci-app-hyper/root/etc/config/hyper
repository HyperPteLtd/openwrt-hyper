config hyper 'infra'
	option __warning 'DO NOT EDIT THIS SECTION, OR YOU ARE ON YOUR OWN!'
	option mixed_port '5330'
	option tproxy_port '5332'
	option dns_port '5333'
	option controller_port '5334'
	option dns_redirect '1'
	option tun_name 'hypertun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	option table_mark '100'
	option self_mark '100'
	option tproxy_mark '101'
	option tun_mark '102'
	# netifd interfaces whose devices are intercepted
	list lan_network 'lan'

config hyper 'account'
	# API endpoints are discovered automatically from Hyper's encrypted DNS TXT records.
	# Generated on first boot by /etc/uci-defaults/luci-hyper; sent as the device identifier
	option device_id ''

config hyper 'config'
	option enabled '0'
	option main_node 'nil'
	# Same defaults as the Hyper app: encrypted DNS through the proxy, AliDNS for direct domains
	option dns_server 'https://1.1.1.1/dns-query'
	option china_dns_server '223.5.5.5'
	# smart or global
	option routing_mode 'smart'
	# 1 = DNS protection only: the core resolves DNS for dnsmasq, LAN traffic goes direct
	option dns_only '0'
	option github_token ''
	option log_level 'warn'

config hyper 'control'
	# disabled = every LAN device; listed_only / except_listed use lan_proxy_* / lan_direct_* lists
	option lan_proxy_mode 'disabled'
	# 0 = the router's own traffic (opkg, NTP, ...) stays direct
	option proxy_router_self '1'
	list wan_proxy_ipv4_ips '91.105.192.0/23'
	list wan_proxy_ipv4_ips '91.108.4.0/22'
	list wan_proxy_ipv4_ips '91.108.8.0/22'
	list wan_proxy_ipv4_ips '91.108.16.0/22'
	list wan_proxy_ipv4_ips '91.108.12.0/22'
	list wan_proxy_ipv4_ips '91.108.20.0/22'
	list wan_proxy_ipv4_ips '91.108.56.0/22'
	list wan_proxy_ipv4_ips '149.154.160.0/20'
	list wan_proxy_ipv4_ips '185.76.151.0/24'
	list wan_proxy_ipv4_ips '203.208.50.66/32'
	list wan_proxy_ipv6_ips '2001:67c:4e8::/48'
	list wan_proxy_ipv6_ips '2001:b28:f23c::/48'
	list wan_proxy_ipv6_ips '2001:b28:f23d::/48'
	list wan_proxy_ipv6_ips '2001:b28:f23f::/48'
	list wan_proxy_ipv6_ips '2a0a:f280::/32'

config hyper 'subscription'
	option auto_update '1'
	option auto_update_time '4'
	# Links without an explicit insecure flag skip certificate checks, like the Hyper app (AnyTLS nodes)
	option allow_insecure '1'

config hyper 'update'
	option auto_check '1'
	option auto_update '0'
	option repo 'HyperPteLtd/openwrt-hyper'

config hyper 'rules'
	# Server rule lists (GET <api_base>/api/subscribe/rules) the user switched off
