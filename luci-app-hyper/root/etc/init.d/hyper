#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Hyper Pte. Ltd.
#
# hyperd serve owns the mihomo core, the network takeover and the luci.hyper methods;
# hyperd guard releases the takeover (fail open) if serve or the core stops answering.
# The UI's start/stop switch is hyper.config.enabled, applied by serve; this service
# itself always runs so the UI can sign in and sync while the proxy is off.

USE_PROCD=1
START=99
STOP=10

HYPERD=/usr/libexec/hyper/bin/hyperd
NETWORK=/usr/libexec/hyper/network
RUN_DIR=/var/run/hyper

start_service() {
	mkdir -p "$RUN_DIR"
	chmod 0711 "$RUN_DIR"
	rm -f "$RUN_DIR/stopping"

	procd_open_instance serve
	procd_set_param command "$HYPERD" serve
	# The core inherits it: one socket per proxied connection.
	procd_set_param limits nofile="1000000 1000000"
	# On SIGTERM serve releases the takeover (it may wait for fw4's lock), then stops the
	# core (5 s at most); procd's default of 5 s would cut that short.
	procd_set_param term_timeout 20
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance

	procd_open_instance guard
	procd_set_param command "$HYPERD" guard
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	# rc.common releases here, then signals serve: until a start, the marker keeps serve's
	# monitor (or a restart queued meanwhile) from taking the LAN over again in between.
	mkdir -p "$RUN_DIR"
	touch "$RUN_DIR/stopping"
	# serve releases the takeover on SIGTERM; this covers a serve that already died.
	"$NETWORK" down >/dev/null 2>&1 || :
}

service_stopped() {
	"$NETWORK" down >/dev/null 2>&1 || :
}

reload_service() {
	# Manual UCI edits: apply them through serve (ignored while hyper is disabled).
	echo '{}' | "$HYPERD" call restart >/dev/null 2>&1 || restart
}
